# The health-only Lambda and local dev server do not require environment variables.
# OpenRouter (AI insights + profile coach suggestions):
#   OPENROUTER_API_KEY=sk-or-...
#   OPENROUTER_MODEL=openrouter/free   # optional
# Set OPENROUTER_API_KEY in the shell before `cdk deploy` so Lambda env is populated.

# Local Ollama (offline AI categorization & coach suggestions):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Plaid Configuration
# Default environment is sandbox unless PLAID_ENV=production is explicitly set.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Optional redirect URI (must match Plaid dashboard allowed redirect URIs if configured):
# PLAID_REDIRECT_URI=http://localhost:5173/connections
# Optional Webhook URL:
# PLAID_WEBHOOK_URL=https://your-domain.com/api/plaid/webhook

