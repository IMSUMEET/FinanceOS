# Copy to `.env.local` for local dev. Production uses `.env.production` (committed).
# All vars are read at build time by Vite (must start with VITE_).

# Lambda 1 — File-Processing stack (local CSV analyze + coach suggestions).
VITE_API_BASE_URL=https://k6uky3zf9c.execute-api.us-east-2.amazonaws.com

# Lambda 2 — FinanceOsAiCsvAnalyzerStack (Import "AI analysis" button). POST CSV to /.
VITE_AI_ANALYZER_URL=https://2h3e3ajk77.execute-api.us-east-2.amazonaws.com

# Local dev against `npm run dev` in backend/ (port 3001):
# VITE_API_BASE_URL=http://localhost:3001
# VITE_AI_ANALYZER_URL=http://localhost:3001
# VITE_USE_MOCK=false

# Force mock mode even if VITE_API_BASE_URL is set. Useful for design QA.
VITE_USE_MOCK=false
